# Firebase Configuration (already public in client code)
# These are for reference only - actual config is in firebase-config.js

FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.europe-west1.firebasedatabase.app

# For CI/CD deployment (keep secret!)
# Generate with: firebase login:ci
FIREBASE_TOKEN=your_firebase_ci_token
